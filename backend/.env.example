# Application
APP_NAME=GovernanceMonitor
APP_ENV=dev
SECRET_KEY=change-me-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database. Defaults to local SQLite if unset.
# For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg2://gov:gov@db:5432/governance
DATABASE_URL=sqlite:///./governance.db

# Initial admin (created on first run if no users exist)
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123
INIT_ADMIN_EMAIL=admin@example.com

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
